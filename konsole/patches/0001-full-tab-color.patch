-        painter.setBrush(color);
+        // Fill the whole tab and redraw its label on top; inactive tabs are dimmed
+        // towards the window colour so the current tab stays recognisable.
+        QColor progressColor = color;
+        if (colorValid) {
+            const QColor fill = tabIndex == currentIndex() ? color : mix(color, palette().window().color(), 0.45);
+            const QColor text = contrastingText(fill);
+            painter.save();
+            painter.setRenderHint(QPainter::Antialiasing);
+            painter.setBrush(fill);
+            painter.drawRoundedRect(QRectF(tabRect(tabIndex)).adjusted(1.5, 2.5, -1.5, -1.5), 4, 4);
+            painter.restore();
+
+            QStyleOptionTab opt;
+            initStyleOption(&opt, tabIndex);
+            opt.palette.setColor(QPalette::WindowText, text);
+            opt.palette.setColor(QPalette::ButtonText, text);
+            opt.palette.setColor(QPalette::Text, text);
+            opt.palette.setColor(QPalette::HighlightedText, text);
+            style()->drawControl(QStyle::CE_TabBarTabLabel, &opt, &painter, this);
+            progressColor = text;
+        }
+
+        painter.setBrush(progressColor);
         QRect tRect = tabRect(tabIndex);
