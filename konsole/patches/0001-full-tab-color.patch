     QPainter painter(this);
     painter.setPen(Qt::NoPen);
 
+    // WCAG relative luminance; black text when it contrasts better than white.
+    const auto contrastingText = [](const QColor &c) {
+        const auto lin = [](qreal v) {
+            return v <= 0.04045 ? v / 12.92 : std::pow((v + 0.055) / 1.055, 2.4);
+        };
+        const qreal l = 0.2126 * lin(c.redF()) + 0.7152 * lin(c.greenF()) + 0.0722 * lin(c.blueF());
+        return l > 0.179 ? QColor(Qt::black) : QColor(Qt::white);
+    };
+    const auto mix = [](const QColor &a, const QColor &b, qreal t) {
+        return QColor::fromRgbF(a.redF() * (1 - t) + b.redF() * t, a.greenF() * (1 - t) + b.greenF() * t, a.blueF() * (1 - t) + b.blueF() * t);
+    };
+
     for (int tabIndex = 0; tabIndex < count(); tabIndex++) {
         const QVariant data = tabData(tabIndex);
         if (!data.isValid() || data.isNull()) {
@@ -208,7 +223,29 @@ void DetachableTabBar::paintEvent(QPaintEvent *event)
 
